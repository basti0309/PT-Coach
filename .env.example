# Alle Variablen in Vercel unter Project → Settings → Environment Variables eintragen
# (siehe README_SETUP.md). Diese Datei enthält nur Platzhalter.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key
# Geheim! Nur serverseitig, niemals in Browser-Code verwenden.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# --- App ---
# Öffentliche Adresse der App ohne Schrägstrich am Ende, z. B. https://pt-coach.vercel.app
NEXT_PUBLIC_SITE_URL=https://DEINE-APP.vercel.app
# Wer sich mit dieser Adresse anmeldet, wird automatisch Coach.
COACH_EMAIL=deine-adresse@example.com
# Zeitzone für "heute" (optional)
APP_TIMEZONE=Europe/Berlin

# --- Claude API (KI-Vorfilter im Chat) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional, Standard: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# --- Strava (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=dein-strava-client-secret
# Frei wählbares Geheimwort für die Webhook-Validierung (z. B. 32 zufällige Zeichen)
STRAVA_WEBHOOK_VERIFY_TOKEN=ein-langes-zufaelliges-wort
# API-Basis-URL. Strava stellt 2027 auf eine neue Adresse um – dann nur diesen Wert ändern.
STRAVA_API_BASE=https://www.strava.com/api/v3
# Optional: Autorisierungsseite (Standard: https://www.strava.com/oauth/authorize)
STRAVA_AUTHORIZE_URL=https://www.strava.com/oauth/authorize
